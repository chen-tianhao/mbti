  "dimensions": [
    {
      "code": "MI",
      "name": "精力方向",
      "nameEn": "Mind",
      "description": "决定我们与环境互动的方式：向外在世界寻求刺激与连接，还是向内在世界寻求安静与深度。",
      "poleA": {
        "code": "E",
        "name": "外向",
        "nameEn": "Extraverted",
        "description": "通过社交、行动与外部互动获取能量；表达直接，乐于成为注意力的中心。"
      },
      "poleB": {
        "code": "I",
        "name": "内向",
        "nameEn": "Introverted",
        "description": "通过独处、反思与深度交流恢复能量；表达克制，偏好安静、可控的刺激水平。"
      }
    },
    {
      "code": "EN",
      "name": "信息认知",
      "nameEn": "Energy",
      "description": "决定我们如何处理信息：聚焦具体事实与当下现实，还是聚焦模式、可能性与抽象意义。",
      "poleA": {
        "code": "S",
        "name": "观察型",
        "nameEn": "Observant",
        "description": "务实、具体、关注当下细节与可执行方案，信任经验与事实。"
      },
      "poleB": {
        "code": "N",
        "name": "直觉型",
        "nameEn": "Intuitive",
        "description": "富有想象力、关注未来可能性与事物关联，喜欢抽象思考与新概念。"
      }
    },
    {
      "code": "NA",
      "name": "决策与情感",
      "nameEn": "Nature",
      "description": "决定我们如何做决定与处理情绪：以客观逻辑与效率为准，还是以人际感受与价值认同为准。",
      "poleA": {
        "code": "T",
        "name": "思考型",
        "nameEn": "Thinking",
        "description": "注重逻辑、效率与客观标准；直率、就事论事，重视事实胜过感受。"
      },
      "poleB": {
        "code": "F",
        "name": "情感型",
        "nameEn": "Feeling",
        "description": "注重同理、和谐与个人价值；敏感细腻，重视他人的感受与共识。"
      }
    },
    {
      "code": "TA",
      "name": "生活与计划",
      "nameEn": "Tactics",
      "description": "决定我们应对外部世界的方式：偏好计划、秩序与确定性，还是偏好灵活、开放与自发性。",
      "poleA": {
        "code": "J",
        "name": "判断型",
        "nameEn": "Judging",
        "description": "有条理、守时、喜欢明确决定与清晰计划，讨厌失控与拖延。"
      },
      "poleB": {
        "code": "P",
        "name": "展望型",
        "nameEn": "Prospecting",
        "description": "灵活、善于应变、喜欢保留选择空间，讨厌僵化计划与过早定论。"
      }
    },
    {
      "code": "ID",
      "name": "自我与压力",
      "nameEn": "Identity",
      "description": "决定我们对自身能力、情绪与压力的反应方式（该维度为 16P 相对 MBTI 的扩展维度）。",
      "poleA": {
        "code": "A",
        "name": "坚决型",
        "nameEn": "Assertive",
        "description": "情绪平稳、自信从容、抗压性强，不易被外界评价左右，对现状较满意。"
      },
      "poleB": {
        "code": "T",
        "name": "谨慎型",
        "nameEn": "Turbulent",
        "description": "自我要求高、对压力与评价更敏感、容易反复反思，常被“做得更好”驱动。"
      }
    }
  ],
