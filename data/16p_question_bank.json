  "scoring": {
    "perQuestion": "每题选择一个选项，选项自带 score（-2 ~ +2）。score > 0 表示偏向该维度 poleA，score < 0 表示偏向 poleB，0 为中立。",
    "aggregation": "对每个维度 code（MI/EN/NA/TA/ID），累加该维度下 12 道题所选选项的 score，得到维度得分（范围 -24 ~ +24）。",
    "interpretation": "前四个维度（MI/EN/NA/TA）得分 > 0 取 poleA 字母，< 0 取 poleB 字母；ID 维度得分 ≥ 0 → A（坚决型），< 0 → T（谨慎型）。",
    "letterOrder": [
      "MI",
      "EN",
      "NA",
      "TA"
    ],
    "identitySuffix": "ID 维度决定结果后缀：≥ 0 为 -A，< 0 为 -T。",
    "tieBreak": "前四个维度若得分为 0，结果代码中用 X 占位（如 INXJ-A）并提示该维度倾向不明显；ID 得分为 0 时默认 -A 并提示倾向不明显。",
    "clientPseudocode": "for q in questions: dimScore[q.dimension] += selectedOption.score; type4 = (dimScore.MI>=0?'E':'I') + (dimScore.EN>=0?'S':'N') + (dimScore.NA>=0?'T':'F') + (dimScore.TA>=0?'J':'P'); suffix = dimScore.ID>=0?'-A':'-T'; result = type4 + suffix"
  },
